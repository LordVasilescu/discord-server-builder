# Discord bot token (Developer Portal -> your app -> Bot)
DISCORD_TOKEN=
# Target server ID (optional for some scripts if the bot is in exactly one server)
GUILD_ID=
# Channel/emoji IDs used by the one-off pin/setup scripts
REDLINE_CHANNEL_ID=
WARLORD_CHANNEL_ID=
BLOODSPLAT_EMOJI_ID=
# TMDB API key for the /movie and /willis commands in bot.mjs
TMDB_API_KEY=
# Streaming-availability region for TMDB watch providers (default US)
WATCH_REGION=
# Referral code shown by the Orgo gate scripts
ORGO_REFERRAL_CODE=
